# Pin line endings so a Windows checkout cannot corrupt files that must be LF.
#
# Git for Windows defaults to core.autocrlf=true, which rewrites the working
# tree to CRLF on checkout. For most files that is harmless. For three kinds
# here it is not:
#
#   *.sh          bash reads the CR as part of the command and fails with
#                 "$'\r': command not found" -- this would break
#                 scripts/build_space.sh and therefore `make space-push`
#   Dockerfile    CRLF breaks backslash line-continuations in RUN blocks
#   Makefile      recipe lines are whitespace-sensitive
#
# `eol=lf` forces LF in the working tree regardless of core.autocrlf, so the
# repo behaves identically on Windows, Linux, macOS, in CI, and in the Space
# container.

* text=auto eol=lf

# Windows-native tooling. PowerShell handles LF fine but CRLF is idiomatic and
# avoids surprises in older hosts and ISE.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Explicit for the files where it actually matters.
*.sh        text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.cff       text eol=lf

# Never touch these.
*.bundle binary
*.png    binary
*.jpg    binary
*.gz     binary
*.tar    binary
*.snapshot binary
